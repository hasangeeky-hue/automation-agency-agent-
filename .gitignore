# The WordPress theme lives in its own repo (automation-agency)
anthropos-design/
# Design assets, not code
Brand design/
# Local editor/launch config
.claude/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Secrets & local state — NEVER commit (the .env.example IS committed)
deploy/.env
.env
fixtures/

# DATABASE DUMPS. A pg_dump of this engine contains every credential in
# PLAINTEXT — all 91 settings rows, the leads, the deals. `*.sql` alone did not
# cover `engine-*.sql.gz`, and a dump copied into this directory would have been
# committed by `git add -A` and pushed to GitHub.
*.sql
*.sql.gz
*.dump
*.sql.gz.SUSPECT
engine-*.gz
content-engine-backups/

# Graphify output — a generated map of every file, schema and config in here.
# Regenerable in seconds, and not something to commit.
graphify-out/

# OS / editor
.DS_Store
Thumbs.db
